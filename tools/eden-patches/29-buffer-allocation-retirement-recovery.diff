+    // The caller must first wait for every GPU use of the retired objects.
+    size_t ClearAfterSynchronization() {
+        size_t count = 0;
+        for (auto& bucket : elements) {
+            count += bucket.size();
+            bucket.clear();
+        }
+        return count;
+    }
