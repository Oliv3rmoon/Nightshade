+
+// A storage image (or image buffer) indexed by a value the shader computes is sized from the
+// constant buffer space after its first handle, up to DESCRIPTOR_MAX_COUNT elements, and only
+// sampled textures had a cap. Every element is bound at each draw or dispatch, its handle read
+// from the constant buffer: past the game's own array those words are other data read as
+// handles (empty texture descriptors), and OpenGL keeps a pipeline's views in fixed arrays (64
+// textures and 16 images in compute, 8 in graphics), so a longer array ended the session with
+// boost::container::bad_alloc or wrote past them. The shader keeps its index within the array
+// (UMin below), so a shorter array clamps the access instead. At most MAX_DYNAMIC_STORAGE_IMAGES
+// elements in all, shared between such arrays: what yuzu bound for every indexed descriptor, and
+// OpenGL's graphics limit; fewer when the host allows fewer.
+constexpr u32 MAX_DYNAMIC_STORAGE_IMAGES = 8;
+
+u32 DynamicStorageImageArrayCount(const TextureInstVector& to_replace) {
+    boost::container::small_vector<std::pair<u32, u32>, 4> arrays;
+    for (const TextureInst& inst : to_replace) {
+        if (inst.cbuf.count <= 1 || !IsStorageImageOpcode(IndexedInstruction(*inst.inst))) {
+            continue;
+        }
+        const std::pair<u32, u32> array{inst.cbuf.index, inst.cbuf.offset};
+        if (std::ranges::find(arrays, array) == arrays.end()) {
+            arrays.push_back(array);
+        }
+    }
+    return static_cast<u32>(arrays.size());
 }
 
+u32 DynamicStorageImageCap(const HostTranslateInfo& host_info, u32 dynamic_arrays) {
+    auto const limit = (std::max)(1U, (std::min)(MAX_DYNAMIC_STORAGE_IMAGES,
+                                                 host_info.max_descriptor_set_storage_images));
+    return (std::max)(1U, limit / (std::max)(1U, dynamic_arrays));
+}
