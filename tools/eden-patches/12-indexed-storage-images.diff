+
+// A storage image (or image buffer) indexed by a value the shader computes is sized from the
+// constant buffer space after its first handle, up to DESCRIPTOR_MAX_COUNT elements, and only
+// sampled textures had a cap. Every element is bound at each draw or dispatch, its handle read
+// from the constant buffer: past the game's own array those words are other data read as
+// handles (empty texture descriptors), and OpenGL keeps a pipeline's views in fixed arrays (64
+// textures and 16 images in compute, 8 in graphics), so a longer array ended the session with
+// boost::container::bad_alloc or wrote past them. The shader keeps its index within the array
+// (UMin below), so a shorter array clamps the access instead.
+// Each such array gets MAX_DYNAMIC_STORAGE_IMAGES elements, what yuzu bound for every indexed
+// descriptor. Only where the host's storage image limit cannot hold that many for every array
+// beside the shader's other storage images (OpenGL reports 8) is the room left shared between the
+// arrays, never under one element each.
+constexpr u32 MAX_DYNAMIC_STORAGE_IMAGES = 8;
+
+struct StorageImageUse {
+    u32 static_images{};  // storage images the shader names by one handle each
+    u32 dynamic_arrays{}; // storage image arrays it indexes
+};
+
+StorageImageUse StorageImageUses(const TextureInstVector& to_replace) {
+    boost::container::small_vector<std::pair<u32, u32>, 8> statics, arrays;
+    for (const TextureInst& inst : to_replace) {
+        if (!IsStorageImageOpcode(IndexedInstruction(*inst.inst))) {
+            continue;
+        }
+        auto& seen = inst.cbuf.count > 1 ? arrays : statics;
+        const std::pair<u32, u32> handle{inst.cbuf.index, inst.cbuf.offset};
+        if (std::ranges::find(seen, handle) == seen.end()) {
+            seen.push_back(handle);
+        }
+    }
+    return {static_cast<u32>(statics.size()), static_cast<u32>(arrays.size())};
+}
+
+// host_limit: the storage images a stage can bind.
+u32 StorageImageArrayCap(u32 host_limit, StorageImageUse use) {
+    if (use.dynamic_arrays == 0) {
+        return MAX_DYNAMIC_STORAGE_IMAGES;
+    }
+    const u32 room = host_limit > use.static_images ? host_limit - use.static_images : 0;
+    return (std::max)(1U, (std::min)(MAX_DYNAMIC_STORAGE_IMAGES, room / use.dynamic_arrays));
 }
 
+u32 DynamicStorageImageCap(const HostTranslateInfo& host_info, const TextureInstVector& to_replace) {
+    // A Vulkan device's own limits (large on RADV), or OpenGL's 8 (gl_shader_cache.cpp).
+    const u32 host_limit =
+        (std::min)(host_info.max_descriptor_set_storage_images, host_info.max_per_stage_resources);
+    return StorageImageArrayCap(host_limit, StorageImageUses(to_replace));
+}
