+bool MaxwellDMA::LaunchConstantFill() {
+    const auto& remap = regs.remap_const;
+    const std::array<u32, 4> swizzles{
+        static_cast<u32>(remap.dst_x.Value()), static_cast<u32>(remap.dst_y.Value()),
+        static_cast<u32>(remap.dst_z.Value()), static_cast<u32>(remap.dst_w.Value())};
+    const u32 component_size = remap.component_size_minus_one + 1;
+    const u32 num_components = remap.num_dst_components_minus_one + 1;
+    const std::optional<ConstantFill> fill =
+        MakeConstantFill(component_size, num_components, swizzles, remap.remap_consta_value,
+                         remap.remap_constb_value);
+    if (!fill) {
+        return false;
+    }
+    const bool multi_line = regs.launch_dma.multi_line_enable != 0;
+    if (multi_line && regs.launch_dma.dst_memory_layout != LaunchDMA::MemoryLayout::PITCH) {
+        return false; // a block-linear destination: as before
+    }
+    const u32 lines = multi_line ? regs.line_count : 1;
+    const u64 line_bytes = u64{regs.line_length_in} * fill->element_size;
+    ReportConstantFill(*fill, component_size, num_components, regs.line_length_in, lines,
+                       multi_line, swizzles[0] == 4, remap.remap_consta_value);
+    if (line_bytes == 0 || lines == 0) {
+        return true;
+    }
+    memory_manager.FlushCaching();
+    auto& accelerate = rasterizer->AccessAccelerateDMA();
+    const std::optional<u32> word = fill->Word();
+    static constexpr u64 PIECE = 4096;
+    for (u32 line = 0; line < lines; ++line) {
+        const GPUVAddr dst =
+            regs.offset_out + (multi_line ? static_cast<s64>(line) * regs.pitch_out : 0);
+        if (word && dst % 4 == 0 && line_bytes % 4 == 0 &&
+            accelerate.BufferClear(dst, line_bytes / 4, *word)) {
+            // The buffer cache filled its copy on the GPU, in order with the work before it.
+            // Guest memory gets the same bytes.
+            write_buffer.resize_destructive(PIECE);
+            std::ranges::fill(std::span<u32>(reinterpret_cast<u32*>(write_buffer.data()), PIECE / 4),
+                              *word);
+            for (u64 done = 0; done < line_bytes; done += PIECE) {
+                memory_manager.WriteBlockUnsafe(dst + done, write_buffer.data(),
+                                                (std::min)(PIECE, line_bytes - done));
+            }
+            continue;
+        }
+        // Otherwise guest memory and the buffer cache's copy get the fill. Writing guest memory
+        // alone left the buffer cache's copy as it was, which the GPU went on using: a counter a
+        // game cleared this way and a shader then added to kept its old value. The texture cache
+        // is not told, as it never was of these fills: an image the fill covers only in part would
+        // take guest memory's older copy of the rest of it at its next upload, losing what the GPU
+        // drew there.
+        const GPUVAddr end = dst + line_bytes;
+        // A page the fill only partly covers, or a fill that keeps some bytes: a piece at a time
+        // within a page, which the buffer cache writes into its copy in order with the GPU's
+        // work, so GPU data beside them stays.
+        const auto fill_pieces = [&](GPUVAddr begin, GPUVAddr stop) {
+            for (GPUVAddr at = begin; at < stop;) {
+                const u64 piece = (std::min)(stop - at, PIECE - (at & (PIECE - 1)));
+                write_buffer.resize_destructive(piece);
+                if (fill->keeps_bytes) {
+                    memory_manager.ReadBlock(at, write_buffer.data(), piece);
+                    u64 in_element = (at - dst) % fill->element_size;
+                    for (u64 i = 0; i < piece; ++i) {
+                        if (fill->written[in_element]) {
+                            write_buffer[i] = fill->pattern[in_element];
+                        }
+                        if (++in_element == fill->element_size) {
+                            in_element = 0;
+                        }
+                    }
+                } else {
+                    FillBytes(*fill, at - dst, write_buffer.data(), piece);
+                }
+                memory_manager.WriteBlockUnsafe(at, write_buffer.data(), piece);
+                if (const std::optional<DAddr> device = memory_manager.GpuToCpuAddress(at)) {
+                    accelerate.BufferWritten(*device,
+                                             std::span<const u8>(write_buffer.data(), piece));
+                }
+                memory_manager.InvalidateRegion(at, piece, VideoCommon::CacheType::QueryCache |
+                                                               VideoCommon::CacheType::ShaderCache);
+                at += piece;
+            }
+        };
+        if (fill->keeps_bytes) {
+            fill_pieces(dst, end);
+            continue;
+        }
+        const auto [whole_begin, whole_end] = WholePages(dst, end, PIECE);
+        fill_pieces(dst, whole_begin);
+        if (whole_end > whole_begin) {
+            // Whole pages: guest memory, then the buffer, query and shader caches invalidate
+            // them, so the buffer cache uploads them (the fill covers each page, so nothing of the
+            // GPU's is lost) and drops a download of them still on its way. One buffer of whole
+            // elements is built once and written over and over.
+            const u64 chunk = (PIECE * 16) / fill->element_size * fill->element_size;
+            write_buffer.resize_destructive(chunk);
+            FillBytes(*fill, whole_begin - dst, write_buffer.data(), chunk);
+            for (GPUVAddr at = whole_begin; at < whole_end; at += chunk) {
+                memory_manager.WriteBlockUnsafe(at, write_buffer.data(),
+                                                (std::min)(chunk, whole_end - at));
+            }
+            memory_manager.InvalidateRegion(whole_begin, whole_end - whole_begin,
+                                            VideoCommon::CacheType::NoTextureCache);
+        }
+        fill_pieces(whole_end, end);
+    }
+    return true;
+}
