+// constant fill: begin (tools/check-dma-fill.py builds this part on its own)
+// A remapped copy whose components are all constants (CONST_A, CONST_B) or not written (NO_WRITE)
+// is a fill: the copy engine reads no source. Each element is num_dst_components components of
+// component_size bytes; a constant component is the low component_size bytes of its constant, and
+// a NO_WRITE one leaves what the destination holds.
+struct ConstantFill {
+    std::array<u8, 16> pattern{};
+    std::array<bool, 16> written{};
+    u32 element_size = 0; // 0: no component is written
+    bool keeps_bytes = false;
+
+    // The 32-bit word the fill is made of, when every byte is written and the element, repeated,
+    // is that word repeated.
+    std::optional<u32> Word() const {
+        if (keeps_bytes || element_size == 0) {
+            return std::nullopt;
+        }
+        u32 word = 0;
+        for (u32 byte = 0; byte < 4; ++byte) {
+            word |= static_cast<u32>(pattern[byte % element_size]) << (8 * byte);
+        }
+        const u32 period = std::lcm(element_size, 4u);
+        for (u32 byte = 0; byte < period; ++byte) {
+            if (pattern[byte % element_size] != static_cast<u8>(word >> (8 * (byte % 4)))) {
+                return std::nullopt;
+            }
+        }
+        return word;
+    }
+};
+
+// Swizzles as RemapConst::Swizzle: 0 to 3 a source component, 4 CONST_A, 5 CONST_B, 6 NO_WRITE.
+// Nothing when a written component comes from the source (a remapped copy).
+std::optional<ConstantFill> MakeConstantFill(u32 component_size, u32 num_components,
+                                             const std::array<u32, 4>& swizzles, u32 const_a,
+                                             u32 const_b) {
+    if (component_size == 0 || component_size > 4 || num_components == 0 || num_components > 4) {
+        return std::nullopt;
+    }
+    ConstantFill fill;
+    bool any_written = false;
+    for (u32 component = 0; component < num_components; ++component) {
+        u32 value = 0;
+        switch (swizzles[component]) {
+        case 4:
+            value = const_a;
+            break;
+        case 5:
+            value = const_b;
+            break;
+        case 6:
+            fill.keeps_bytes = true;
+            continue;
+        default:
+            return std::nullopt;
+        }
+        any_written = true;
+        for (u32 byte = 0; byte < component_size; ++byte) {
+            fill.pattern[component * component_size + byte] = static_cast<u8>(value >> (8 * byte));
+            fill.written[component * component_size + byte] = true;
+        }
+    }
+    fill.element_size = any_written ? component_size * num_components : 0;
+    return fill;
+}
+
+// The fill's bytes from `offset` bytes after its start, `size` of them, into `out`; every byte of
+// the fill is written (no NO_WRITE component). A fill that repeats an 8-byte word (a 1, 2, 4 or
+// 8-byte one among them) is stored a word at a time; any other gets one element, then copies of
+// what is already there, each twice as long as the one before.
+void FillBytes(const ConstantFill& fill, u64 offset, u8* out, u64 size) {
+    const u32 element = fill.element_size;
+    if (size == 0 || element == 0) {
+        return;
+    }
+    const auto byte = [&](u64 at) { return fill.pattern[at % element]; };
+    bool repeats_word = true;
+    for (u64 i = 0; i < std::lcm(u64{element}, u64{8}) && repeats_word; ++i) {
+        repeats_word = byte(i) == byte(i % 8);
+    }
+    if (repeats_word) {
+        // The word, eight times over: stored 64 bytes at a time.
+        u8 block[64];
+        for (u64 i = 0; i < sizeof(block); ++i) {
+            block[i] = byte(offset + i % 8);
+        }
+        u64 done = 0;
+        for (; done + sizeof(block) <= size; done += sizeof(block)) {
+            std::memcpy(out + done, block, sizeof(block));
+        }
+        std::memcpy(out + done, block, size - done);
+        return;
+    }
+    u64 done = (std::min)(size, u64{element});
+    for (u64 i = 0; i < done; ++i) {
+        out[i] = byte(offset + i);
+    }
+    while (done < size) {
+        const u64 copy = (std::min)(done, size - done);
+        std::memcpy(out + done, out, copy);
+        done += copy;
+    }
+}
+
+// The whole pages of [begin, end): the first and the end of them (equal when there are none).
+std::pair<u64, u64> WholePages(u64 begin, u64 end, u64 page) {
+    const u64 first = (std::min)(end, (begin + page - 1) / page * page);
+    return {first, (std::max)(first, end / page * page)};
+}
+// constant fill: end
+
+// The first fills whose shape the copy engine's earlier emulation got wrong, for stderr.log: it
+// wrote line_length_in * component_size bytes (an element of one component), to guest memory
+// only unless the component was 4 bytes, and it copied from offset_in for a multi-line fill or
+// one whose first component was not CONST_A.
+void ReportConstantFill(const ConstantFill& fill, u32 component_size, u32 num_components,
+                        u32 line_length, u32 lines, bool multi_line, bool first_is_const_a,
+                        u32 const_a) {
+    const bool was_right = !multi_line && first_is_const_a && num_components == 1 &&
+                           component_size == 4 && !fill.keeps_bytes;
+    static std::atomic<u32> reports{0};
+    if (was_right || reports.fetch_add(1, std::memory_order_relaxed) >= 16) {
+        return;
+    }
+    const unsigned long long before =
+        (!multi_line && first_is_const_a) ? u64{line_length} * component_size : 0;
+    std::fprintf(stderr,
+                 "EDEN_DMA_FILL elements=%u components=%ux%u lines=%u multi_line=%u const_a=0x%08x "
+                 "bytes=%llu before=%llu gpu_copy_before=%s\n",
+                 line_length, num_components, component_size, lines, multi_line ? 1U : 0U, const_a,
+                 static_cast<unsigned long long>(u64{line_length} * fill.element_size) * lines,
+                 before,
+                 (!multi_line && first_is_const_a && component_size == 4) ? "filled" : "missed");
+}
