+// An indirect draw the CPU makes from its parameters, asking for more than 2^32 vertices
+// (count x instances), is not a real draw: no Switch game draws that many in one call, and the
+// host GPU would run it until it is reset. Such parameters are memory read before the GPU's write
+// to it arrived. They are read once more through the caches, and the draw is dropped if they
+// still say so.
+bool IsDrawImplausible(u32 count, u32 instance_count) {
+    return u64(count) * u64(instance_count) > (u64(1) << 32);
+}
+
+void ReportDroppedDraw(const char* macro, u32 count, u32 instance_count) {
+    static std::atomic<u32> reports{0};
+    if (reports.fetch_add(1, std::memory_order_relaxed) < 16) {
+        std::fprintf(stderr, "EDEN_INDIRECT_DRAW_DROPPED macro=%s count=%u instances=%u\n", macro,
+                     count, instance_count);
+    }
+}
+
