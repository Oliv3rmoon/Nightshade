+// One owner represents one successful nvmap pin. Split ranges share that pin
+// until their last surviving fragment is replaced or the address space closes.
+class SparseMappingOwnership {
+public:
+    template <class Apply>
+    void Replace(u64 begin, u64 size, std::shared_ptr<void> owner, Apply&& apply) {
+        if (size == 0) {
+            std::forward<Apply>(apply)();
+            return;
+        }
+        if (size > (std::numeric_limits<u64>::max)() - begin) {
+            throw std::invalid_argument("Sparse mapping range overflow");
+        }
+        const u64 end = begin + size;
+        auto first = ranges.upper_bound(begin);
+        if (first != ranges.begin()) {
+            const auto previous = std::prev(first);
+            if (previous->second.end > begin) first = previous;
+        }
+        const auto last = ranges.lower_bound(end);
+
+        // Allocate at most three replacement nodes before changing GPU mappings.
+        // No owning range is removed if preparation or the GPU update throws.
+        std::map<u64, Range> replacement;
+        if (first != last) {
+            if (first->first < begin) {
+                replacement.emplace(first->first, Range{begin, first->second.owner});
+            }
+            const auto previous = std::prev(last);
+            if (previous->second.end > end) {
+                replacement.emplace(end, Range{previous->second.end, previous->second.owner});
+            }
+        }
+        if (owner) replacement.emplace(begin, Range{end, std::move(owner)});
+
+        std::forward<Apply>(apply)();
+        ranges.erase(first, last);
+        ranges.merge(replacement); // Transfers prepared nodes without allocating.
+    }
+
+private:
+    struct Range {
+        u64 end;
+        std::shared_ptr<void> owner;
+    };
+    std::map<u64, Range> ranges;
+};
