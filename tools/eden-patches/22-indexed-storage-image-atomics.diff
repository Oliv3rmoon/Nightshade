+struct StorageImageRef {
+    Id pointer;
+    Id image_type;
+    bool is_integer;
+    bool non_uniform;
+};
+
+template <typename Definition>
+StorageImageRef StorageImage(EmitContext& ctx, const IR::Value& index, const Definition& def,
+                             NonUniformKind kind) {
+    if (def.count <= 1) {
+        return {def.id, def.image_type, def.is_integer, false};
+    }
+    const Id idx{index.IsImmediate() ? ctx.Const(index.U32()) : ctx.Def(index)};
+    const bool non_uniform{MarkNonUniform(ctx, idx, index, kind)};
+    const Id pointer{ctx.OpAccessChain(def.pointer_type, def.id, idx)};
+    if (non_uniform) {
+        DecorateNonUniform(ctx, pointer);
+    }
+    return {pointer, def.image_type, def.is_integer, non_uniform};
+}
+
+StorageImageRef StorageImage(EmitContext& ctx, const IR::Value& index, IR::TextureInstInfo info) {
