+#include <algorithm>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
 #include "common/thread_worker.h"

@@ -10,3 +15,54 @@
 Common::ThreadWorker& GetThreadWorkers();

+// The GPU and background texture decoder share workers. A conversion can use its
+// output as soon as its own rows are ready, even if another caller has queued work.
+template <typename ProcessRow>
+void TranscodeRows(std::uint32_t rows, std::uint32_t blocks_per_row, const ProcessRow& process_row) {
+    if (rows <= 1 || std::uint64_t{rows} * blocks_per_row <= 16) {
+        for (std::uint32_t row = 0; row < rows; ++row) {
+            process_row(row);
+        }
+        return;
+    }
+
+    const auto rows_per_job = std::clamp(rows / 32, 1u, 8u);
+    const auto num_jobs = 1 + (rows - 1) / rows_per_job;
+    auto remaining = num_jobs;
+    std::mutex mutex;
+    std::condition_variable complete;
+    const auto finish = [&](std::uint32_t jobs) {
+        std::lock_guard lock{mutex};
+        remaining -= jobs;
+        if (remaining == 0) {
+            complete.notify_one();
+        }
+    };
+    const auto wait = [&] {
+        std::unique_lock lock{mutex};
+        complete.wait(lock, [&] { return remaining == 0; });
+    };
+
+    auto& workers = GetThreadWorkers();
+    std::uint32_t submitted = 0;
+    try {
+        for (; submitted < num_jobs; ++submitted) {
+            const auto first = submitted * rows_per_job;
+            const auto past = first + (std::min)(rows_per_job, rows - first);
+            workers.QueueWork([&, first, past] {
+                for (auto row = first; row < past; ++row) {
+                    process_row(row);
+                }
+                finish(1);
+            });
+        }
+    } catch (...) {
+        // Keep the caller's input, output and completion state alive until
+        // any jobs accepted before the failed enqueue have finished.
+        finish(num_jobs - submitted);
+        wait();
+        throw;
+    }
+    wait();
 }
+
+}
