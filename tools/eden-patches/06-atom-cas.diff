+                                              const U32U64& value) {
+    if (compare.Type() != value.Type()) {
+        throw InvalidArgument("Mismatching types {} and {}", compare.Type(), value.Type());
+    }
+    switch (value.Type()) {
+    case Type::U32:
+        return Inst<U32>(Opcode::GlobalAtomicCompareExchange32, pointer_offset, compare, value);
+    case Type::U64:
+        return Inst<U64>(Opcode::GlobalAtomicCompareExchange64, pointer_offset, compare, value);
+    default:
+        ThrowInvalidType(value.Type());
+    }
+}
