+// Large requests are rare; record existing operands without reads or GPU waits.
+// Separate huge requests so smaller legitimate bindings cannot hide them.
+inline void LogLargeBufferBinding(const char* kind, GPUVAddr gpu, u64 bytes,
+                                  u64 operand0 = 0, u64 operand1 = 0,
+                                  u64 operand2 = 0, u64 operand3 = 0) {
+    if (bytes < (u64{256} << 20)) return;
+    static std::atomic<u64> large{0}, huge{0};
+    auto& counter = bytes >= (u64{2} << 30) ? huge : large;
+    const u64 sample = counter.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (sample > 8 && (sample & (sample - 1)) != 0) return;
+    LOG_WARNING(HW_GPU,
+                "Large buffer binding: kind={}, gpu={:#x}, bytes={}, operand0={:#x}, operand1={:#x}, operand2={:#x}, operand3={:#x}",
+                kind, gpu, bytes, operand0, operand1, operand2, operand3);
+}
