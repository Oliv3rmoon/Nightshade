+bool MaxwellDMA::LaunchConstantFill() {
+    const auto& remap = regs.remap_const;
+    const std::array<u32, 4> swizzles{
+        static_cast<u32>(remap.dst_x.Value()), static_cast<u32>(remap.dst_y.Value()),
+        static_cast<u32>(remap.dst_z.Value()), static_cast<u32>(remap.dst_w.Value())};
+    const u32 component_size = remap.component_size_minus_one + 1;
+    const u32 num_components = remap.num_dst_components_minus_one + 1;
+    const std::optional<ConstantFill> fill =
+        MakeConstantFill(component_size, num_components, swizzles, remap.remap_consta_value,
+                         remap.remap_constb_value);
+    if (!fill) {
+        return false;
+    }
+    const bool multi_line = regs.launch_dma.multi_line_enable != 0;
+    if (multi_line && regs.launch_dma.dst_memory_layout != LaunchDMA::MemoryLayout::PITCH) {
+        return false; // a block-linear destination: as before
+    }
+    const u32 lines = multi_line ? regs.line_count : 1;
+    const u64 line_bytes = u64{regs.line_length_in} * fill->element_size;
+    ReportConstantFill(*fill, component_size, num_components, regs.line_length_in, lines,
+                       multi_line, swizzles[0] == 4, remap.remap_consta_value);
+    if (line_bytes == 0 || lines == 0) {
+        return true;
+    }
+    memory_manager.FlushCaching();
+    auto& accelerate = rasterizer->AccessAccelerateDMA();
+    const std::optional<u32> word = fill->Word();
+    static constexpr u64 PIECE = 4096;
+    for (u32 line = 0; line < lines; ++line) {
+        const GPUVAddr dst =
+            regs.offset_out + (multi_line ? static_cast<s64>(line) * regs.pitch_out : 0);
+        if (word && dst % 4 == 0 && line_bytes % 4 == 0 &&
+            accelerate.BufferClear(dst, line_bytes / 4, *word)) {
+            // The buffer cache filled its copy on the GPU, in order with the work before it.
+            // Guest memory gets the same bytes.
+            write_buffer.resize_destructive(PIECE);
+            std::ranges::fill(std::span<u32>(reinterpret_cast<u32*>(write_buffer.data()), PIECE / 4),
+                              *word);
+            for (u64 done = 0; done < line_bytes; done += PIECE) {
+                memory_manager.WriteBlockUnsafe(dst + done, write_buffer.data(),
+                                                (std::min)(PIECE, line_bytes - done));
+            }
+            continue;
+        }
+        // In pieces within a 4 KiB page, through the inline-to-memory path: guest memory, the
+        // buffer cache's copy (written in order with the GPU's work when the GPU wrote that
+        // memory) and the texture, shader and query caches all get the fill. Writing guest memory
+        // alone left the buffer cache's copy as it was, which the GPU went on using: a counter
+        // a game cleared this way and a shader then added to kept its old value.
+        for (u64 done = 0; done < line_bytes;) {
+            const GPUVAddr at = dst + done;
+            const u64 piece = (std::min)(line_bytes - done, PIECE - (at & (PIECE - 1)));
+            write_buffer.resize_destructive(piece);
+            if (fill->keeps_bytes) {
+                memory_manager.ReadBlock(at, write_buffer.data(), piece);
+            }
+            for (u64 i = 0; i < piece; ++i) {
+                const u64 in_element = (done + i) % fill->element_size;
+                if (fill->written[in_element]) {
+                    write_buffer[i] = fill->pattern[in_element];
+                }
+            }
+            rasterizer->AccelerateInlineToMemory(at, piece,
+                                                 std::span<const u8>(write_buffer.data(), piece));
+            done += piece;
+        }
+    }
+    return true;
+}
